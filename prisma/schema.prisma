// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── USER ───────────────────────────────────────────
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  name         String?
  password     String
  role         Role     @default(CUSTOMER)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders    Order[]
  addresses Address[]
  reviews   Review[]
  cart      Cart?
  invoices  Invoice[]
  couponUses CouponUse[]
  wishlist Wishlist?
  notifications Notification[]
  returnRequests ReturnRequest[]
}

enum Role {
  CUSTOMER
  ADMIN
}

// ── ADDRESS ────────────────────────────────────────
model Address {
  id         Int     @id @default(autoincrement())
  street     String
  city       String
  state      String
  country    String
  postalCode String
  isDefault  Boolean @default(false)

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  orders Order[]
}

// ── CATEGORY ───────────────────────────────────────
model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?

  products Product[]
}

// ── PRODUCT ────────────────────────────────────────
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]
  cartItems  CartItem[]
  wishlistItems WishlistItem[]
  variants    ProductVariant[]
}

// ── REVIEW ─────────────────────────────────────────
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  @@unique([productId, userId])  // one review per product per user
}

// ── CART ───────────────────────────────────────────
model Cart {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int        @unique  // one cart per user

  items     CartItem[]
  discountAmount Decimal?  @db.Decimal(10, 2)
  couponCode     String?
}

model CartItem {
  id       Int @id @default(autoincrement())
  quantity Int @default(1)

  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantId Int?

  @@unique([cartId, productId])  // one entry per product per cart
}

// ── ORDER ──────────────────────────────────────────
model Order {
  id              Int         @id @default(autoincrement())
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @db.Decimal(10, 2)
  taxAmount       Decimal     @db.Decimal(10, 2) @default(0)
  shippingAmount  Decimal     @db.Decimal(10, 2) @default(0)
  grandTotalAmount Decimal     @db.Decimal(10, 2) @default(0)
  stripePaymentId String?     // Stripe payment intent ID
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  address   Address  @relation(fields: [addressId], references: [id])
  addressId Int

  items     OrderItem[]
  payment   Payment?
  invoice   Invoice?
  discountAmount Decimal?  @db.Decimal(10, 2)
  couponCode     String?
  couponUse      CouponUse?
  returnRequest  ReturnRequest?
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// ── ORDER ITEM (snapshot at purchase time) ─────────
model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)  // price AT time of order (snapshot)
  total     Decimal @db.Decimal(10, 2)

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  productName String  // snapshot of name at purchase time
  variantId    Int?
  variantName  String?  // snapshot e.g. "Size: L / Color: Red"
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
}

// ── PAYMENT ────────────────────────────────────────
model Payment {
  id              Int           @id @default(autoincrement())
  stripePaymentId String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("usd")
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  order   Order @relation(fields: [orderId], references: [id])
  orderId Int   @unique
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ── BANNER ─────────────────────────────────────────
model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String?
  image     String   // image URL
  link      String?  // click destination
  isActive  Boolean  @default(true)
  position  Int      @default(0)  // order/priority
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── INVOICE ────────────────────────────────────────
model Invoice {
  id          Int           @id @default(autoincrement())
  invoiceNo   String        @unique  // INV-2026-0001
  status      InvoiceStatus @default(UNPAID)
  issuedAt    DateTime      @default(now())
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order       Order         @relation(fields: [orderId], references: [id])
  orderId     Int           @unique  // one invoice per order

  user        User          @relation(fields: [userId], references: [id])
  userId      Int
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

// ── COUPON ─────────────────────────────────────────
model Coupon {
  id             Int        @id @default(autoincrement())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int        @default(0)
  perUserLimit   Int        @default(1)
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  uses CouponUse[]
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ── COUPON USE ─────────────────────────────────────────
model CouponUse {
  id        Int      @id @default(autoincrement())
  usedAt    DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int @unique

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
}

// ── Wishlist ─────────────────────────────────────────

model Wishlist {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int           @unique

  items     WishlistItem[]
}

// ── Wishlist Item ─────────────────────────────────────────

model WishlistItem {
  id      Int      @id @default(autoincrement())
  addedAt DateTime @default(now())

  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  wishlistId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  Int

  @@unique([wishlistId, productId])
}

// ── Newsletter ─────────────────────────────────────────

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ── Notification ─────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}

enum NotificationType {
  ORDER_PLACED
  PROMO
  SYSTEM
  LOW_STOCK
}

// ── Tax ─────────────────────────────────────────
model Tax {
  id        Int      @id @default(autoincrement())
  name      String
  rate      Decimal @db.Decimal(10, 2)
  type      TaxType
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum TaxType {
  PERCENTAGE
  FIXED
}

// ── Shipping ─────────────────────────────────────────
model Shipping {
  id        Int      @id @default(autoincrement())
  name      String
  price     Decimal @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ── Product image ─────────────────────────────────────────
model ProductImage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  url       String
  isMain    Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
}

// ── Return request ─────────────────────────────────────────
model ReturnRequest {
  id        Int          @id @default(autoincrement())
  reason    String
  details   String?
  status    ReturnStatus @default(PENDING)
  adminNote String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  order   Order @relation(fields: [orderId], references: [id])
  orderId Int   @unique  // one return per order

  user    User  @relation(fields: [userId], references: [id])
  userId  Int
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

// ── Product variant ─────────────────────────────────────────
model ProductVariant {
  id        Int     @id @default(autoincrement())
  name      String  // "Size" or "Color"
  value     String  // "Large" or "Red"
  price     Decimal? @db.Decimal(10, 2)  // override if different price
  stock     Int     @default(0)
  sku       String @unique
  isActive  Boolean @default(true)
  color     String?  // ← hex color for swatches e.g. "#FF5733"
  image     String?  // ← optional variant-specific image

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  cartItems  CartItem[]
  orderItems OrderItem[]
}